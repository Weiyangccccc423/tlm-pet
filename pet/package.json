{
  "name": "winefox-pet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "desktop": "node scripts/desktop.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "qa": "node scripts/qa.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "qa:package": "node scripts/qa.mjs --packaged",
    "qa:game": "node scripts/qa-game.mjs",
    "qa:game:package": "node scripts/qa-game.mjs --packaged"
  },
  "dependencies": {
    "prismarine-nbt": "^2.8.0",
    "three": "^0.180.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "electron": "^38.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
